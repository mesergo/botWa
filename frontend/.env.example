# Frontend Environment Configuration Template
# Copy this file to .env.local for local development or .env.production for production

# API Base URL
# Local: http://localhost:3001/api
# Production: https://app.message.co.il/api
VITE_API_URL=http://localhost:3001/api

# Firebase Web (public) — required for push notifications
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_PUBLIC_KEY=

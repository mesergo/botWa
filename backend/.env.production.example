# Production Environment Variables
NODE_ENV=production

# MongoDB Connection
#---------$$$ MONGODB_URI=mongodb://flowbot:f4l88owb0t@103.95.119.188:27017/flowbot?authSource=flowbot
MONGODB_URI=mongodb://bots:b0t5bots@103.95.119.188:27017/bots?authSource=bots

# Server Configuration  
PORT=3001

# CORS Configuration
